<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ring_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tocai_alarm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="48dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tocai_alarm"
            app:tint="@color/tocai_on_alarm" />

        <TextView
            android:id="@+id/ring_txt_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="80sp" />

        <TextView
            android:id="@+id/ring_txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ring_txt_starts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.85"
            android:gravity="center"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/ring_txt_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="18sp" />

        <Button
            android:id="@+id/ring_btn_stop"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="56dp"
            android:backgroundTint="@color/tocai_on_alarm"
            android:text="@string/ring_stop"
            android:textColor="@color/tocai_alarm_bg"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ring_btn_snooze"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="20sp"
            app:strokeColor="@color/tocai_on_alarm" />
    </LinearLayout>
</ScrollView>
