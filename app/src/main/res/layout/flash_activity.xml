<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tocai_alarm_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tocai_alarm"
            app:tint="@color/tocai_on_alarm" />

        <TextView
            android:id="@+id/flash_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flash_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.9"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="4"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="20sp" />

        <Button
            android:id="@+id/flash_open"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="48dp"
            android:backgroundTint="@color/tocai_on_alarm"
            android:text="@string/flash_open"
            android:textColor="@color/tocai_alarm_bg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.75"
            android:gravity="center"
            android:text="@string/flash_hint"
            android:textColor="@color/tocai_on_alarm"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
